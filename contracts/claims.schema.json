{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simpliolabs/hormozi-skills/contracts/claims.schema.json",
  "title": "CLAIMS",
  "description": "Optional ledger for material or high-risk claims. A clean ledger does not prove clean copy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "wording", "source_type", "status", "sources", "scope", "qualifications", "checked_at", "owner"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "wording": {"type": "string", "minLength": 1},
          "context": {"type": "string"},
          "source_type": {"enum": ["supplied", "sourced", "inferred", "synthetic"]},
          "status": {"enum": ["verified", "qualified", "hypothesis", "unsupported", "prohibited"]},
          "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "scope": {"type": "string"},
          "qualifications": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "checked_at": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"status": {"enum": ["verified", "qualified"]}}, "required": ["status"]}, "then": {"properties": {"sources": {"minItems": 1}}}},
          {"if": {"properties": {"status": {"const": "qualified"}}, "required": ["status"]}, "then": {"properties": {"qualifications": {"minItems": 1}}}}
        ]
      }
    }
  }
}
